# Puerto donde escucha el servidor HTTP (plano en desarrollo).
PORT=8080

# Conexión a MongoDB.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=proservicios

# Secreto para firmar los JWT propios (access + refresh). Generar uno largo y aleatorio.
JWT_SECRET=

# Client ID de la app de Google OAuth. Se usa para validar el ID token que manda el frontend.
GOOGLE_CLIENT_ID=

# Origen permitido por CORS (URL del frontend).
CORS_ORIGIN=http://localhost:5173

# Expiración de los tokens propios, en formato de duración de Go ("15m", "168h").
# Opcionales: si no están, se usan 15m (access) y 168h / 7 días (refresh).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
